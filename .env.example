DATABASE_URL=postgresql://library:library@db:5432/library?schema=public
SESSION_SECRET=replace-with-at-least-32-random-characters
COVER_STORAGE_PATH=/app/data/covers
BOOK_FILE_STORAGE_PATH=/app/data/books
# Optional immutable deployment tag; defaults to latest when omitted.
# MY_LIBRARY_VERSION=v0.7.0
# Local development only: comma-separated hosts allowed to load Next.js resources.
ALLOWED_DEV_ORIGINS=dev.lan
# Set both values to bootstrap the first administrator non-interactively.
# ADMIN_ID=admin
# ADMIN_PASSWORD must be longer than 12 characters.
# ADMIN_PASSWORD=replace-with-a-strong-password
